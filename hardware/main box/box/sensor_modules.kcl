// Sensor module set
// Dedicated GPS, environmental, motion, pulse, LoRa, and ambient-light board envelopes.
@settings(defaultLengthUnit = mm, kclVersion = 2.0, experimentalFeatures = allow)

import * from "parameters.kcl"
import unitBox from "unit_box.kcl"
import unitCylY from "unit_cyl_y.kcl"

gpsBoard = clone(unitBox)
  |> scale(
       x = 25,
       y = 1.2,
       z = 25,
       global = true,
     )
  |> appearance(color = pcbGreen, roughness = 58, metalness = 0)
gpsPatch = clone(unitBox)
  |> scale(
       x = 18,
       y = 4,
       z = 18,
       global = true,
     )
  |> translate(y = -2.6mm, global = true)
  |> appearance(color = "#d8d3c1", roughness = 42, metalness = 10)
export gpsModule = flatten([gpsBoard, gpsPatch])

bmeBoard = clone(unitBox)
  |> scale(
       x = 15,
       y = 1,
       z = 12,
       global = true,
     )
  |> appearance(color = pcbGreen, roughness = 58, metalness = 0)
bmeSensor = clone(unitBox)
  |> scale(
       x = 3,
       y = 2,
       z = 3,
       global = true,
     )
  |> translate(y = -1.4mm, global = true)
  |> appearance(color = hardwareSteel, roughness = 28, metalness = 66)
export bme280Module = flatten([bmeBoard, bmeSensor])

mpuBoard = clone(unitBox)
  |> scale(
       x = 20,
       y = 1,
       z = 16,
       global = true,
     )
  |> appearance(color = "#255aa0", roughness = 58, metalness = 0)
mpuChip = clone(unitBox)
  |> scale(
       x = 5,
       y = 1.8,
       z = 5,
       global = true,
     )
  |> translate(y = -1.3mm, global = true)
  |> appearance(color = tacticalBlack, roughness = 48, metalness = 8)
export mpu6050Module = flatten([mpuBoard, mpuChip])

maxBoard = clone(unitBox)
  |> scale(
       x = 15,
       y = 1,
       z = 15,
       global = true,
     )
  |> appearance(color = "#7e2525", roughness = 58, metalness = 0)
maxSensor = clone(unitBox)
  |> scale(
       x = 5,
       y = 2.2,
       z = 5,
       global = true,
     )
  |> translate(y = -1.5mm, global = true)
  |> appearance(color = "#36151d", roughness = 30, metalness = 10)
export max30102Module = flatten([maxBoard, maxSensor])

loraBoard = clone(unitBox)
  |> scale(
       x = 32,
       y = 1.2,
       z = 20,
       global = true,
     )
  |> appearance(color = pcbGreen, roughness = 58, metalness = 0)
loraShield = clone(unitBox)
  |> scale(
       x = 18,
       y = 2.4,
       z = 12,
       global = true,
     )
  |> translate(y = -1.8mm, global = true)
  |> appearance(color = hardwareSteel, roughness = 28, metalness = 70)
loraAntennaPort = clone(unitCylY)
  |> scale(
       x = 5,
       y = 5,
       z = 5,
       global = true,
     )
  |> translate(x = 13mm, y = -3mm, global = true)
  |> appearance(color = "#d1b45b", roughness = 30, metalness = 74)
export loraModule = flatten([loraBoard, loraShield, loraAntennaPort])

ambientBoard = clone(unitBox)
  |> scale(
       x = 10,
       y = 1,
       z = 10,
       global = true,
     )
  |> appearance(color = pcbGreen, roughness = 58, metalness = 0)
ambientSensor = clone(unitBox)
  |> scale(
       x = 2.5,
       y = 1.8,
       z = 2.5,
       global = true,
     )
  |> translate(y = -1.2mm, global = true)
  |> appearance(color = "#d3c38c", roughness = 26, metalness = 18)
export ambientLightModule = flatten([ambientBoard, ambientSensor])

hide(unitBox)
hide(unitCylY)
