// Raspberry Pi 4 Model B envelope
// Official board size and mounting pattern with manufacturing-clear connector envelopes.
@settings(defaultLengthUnit = mm, kclVersion = 2.0, experimentalFeatures = allow)

import * from "parameters.kcl"
import unitBox from "unit_box.kcl"
import unitCylY from "unit_cyl_y.kcl"

piBoardBlank = clone(unitBox)
  |> scale(
       x = piBoardWidth / 1mm,
       y = 1.6,
       z = piBoardLength / 1mm,
       global = true,
     )
piHoleTopLeft = clone(unitCylY)
  |> scale(
       x = piMountHoleDiameter / 1mm,
       y = 4,
       z = piMountHoleDiameter / 1mm,
       global = true,
     )
  |> translate(x = -piMountSpanX / 2, z = piMountSpanZ / 2, global = true)
piHoleTopRight = clone(piHoleTopLeft)
  |> translate(x = piMountSpanX, global = true)
piHoleBottomLeft = clone(piHoleTopLeft)
  |> translate(z = -piMountSpanZ, global = true)
piHoleBottomRight = clone(piHoleTopRight)
  |> translate(z = -piMountSpanZ, global = true)
piBoardCut1 = subtract([piBoardBlank], tools = [piHoleTopLeft])
piBoardCut2 = subtract([piBoardCut1], tools = [piHoleTopRight])
piBoardCut3 = subtract([piBoardCut2], tools = [piHoleBottomLeft])
piBoard = subtract([piBoardCut3], tools = [piHoleBottomRight])
  |> appearance(color = pcbGreen, roughness = 56, metalness = 0)

piEthernet = clone(unitBox)
  |> scale(
       x = 9,
       y = 14,
       z = 18,
       global = true,
     )
  |> translate(x = 31.5mm, z = 0mm, global = true)
  |> appearance(color = hardwareSteel, roughness = 28, metalness = 78)
piUsbLower = clone(unitBox)
  |> scale(
       x = 8,
       y = 14,
       z = 16,
       global = true,
     )
  |> translate(x = 31mm, z = 26mm, global = true)
  |> appearance(color = hardwareSteel, roughness = 28, metalness = 78)
piUsbUpper = clone(piUsbLower)
  |> translate(z = 18mm, global = true)
piPowerUsbC = clone(unitBox)
  |> scale(
       x = 7,
       y = 8,
       z = 8,
       global = true,
     )
  |> translate(
       x = -31mm,
       y = 1mm,
       z = -10mm,
       global = true,
     )
  |> appearance(color = hardwareSteel, roughness = 28, metalness = 78)
piHdmiLower = clone(unitBox)
  |> scale(
       x = 6,
       y = 9,
       z = 7,
       global = true,
     )
  |> translate(
       x = -31mm,
       y = 1.5mm,
       z = 5mm,
       global = true,
     )
  |> appearance(color = hardwareSteel, roughness = 28, metalness = 78)
piHdmiUpper = clone(piHdmiLower)
  |> translate(z = 13mm, global = true)
piAudioJack = clone(unitCylY)
  |> scale(
       x = 7,
       y = 10,
       z = 7,
       global = true,
     )
  |> rotate(axis = Z, angle = 90deg, global = true)
  |> translate(
       x = -31mm,
       y = 1.5mm,
       z = 31mm,
       global = true,
     )
  |> appearance(color = graphite, roughness = 38, metalness = 35)
piGpioHeader = clone(unitBox)
  |> scale(
       x = 48,
       y = 7,
       z = 5,
       global = true,
     )
  |> translate(y = 3.8mm, z = 38mm, global = true)
  |> appearance(color = tacticalBlack, roughness = 44, metalness = 12)
piCpu = clone(unitBox)
  |> scale(
       x = 18,
       y = 2.4,
       z = 18,
       global = true,
     )
  |> translate(y = 1.7mm, z = -6mm, global = true)
  |> appearance(color = graphite, roughness = 34, metalness = 38)
piHeatSink = clone(unitBox)
  |> scale(
       x = 20,
       y = 5,
       z = 20,
       global = true,
     )
  |> translate(y = 4.5mm, z = -6mm, global = true)
  |> appearance(color = "#737d80", roughness = 34, metalness = 76)

export raspberryPi4 = flatten([
  piBoard,
  piEthernet,
  piUsbLower,
  piUsbUpper,
  piPowerUsbC,
  piHdmiLower,
  piHdmiUpper,
  piAudioJack,
  piGpioHeader,
  piCpu,
  piHeatSink
])

hide(unitBox)
hide(unitCylY)
raspberryPi4
