// Raspberry Pi camera module
// Camera Module 2/3 compatible envelope with mounting holes, lens, ribbon socket, and acrylic shield.
@settings(defaultLengthUnit = mm, kclVersion = 2.0, experimentalFeatures = allow)

import * from "parameters.kcl"
import unitBox from "unit_box.kcl"
import unitCylY from "unit_cyl_y.kcl"

cameraBoardBlank = clone(unitBox)
  |> scale(
       x = cameraBoardWidth / 1mm,
       y = 1.12,
       z = cameraBoardHeight / 1mm,
       global = true,
     )
cameraHoleTopLeft = clone(unitCylY)
  |> scale(
       x = cameraMountHoleDiameter / 1mm,
       y = 3,
       z = cameraMountHoleDiameter / 1mm,
       global = true,
     )
  |> translate(x = -10.5mm, z = 5.5mm, global = true)
cameraHoleTopRight = clone(cameraHoleTopLeft)
  |> translate(x = 21mm, global = true)
cameraHoleBottomLeft = clone(cameraHoleTopLeft)
  |> translate(z = -12.5mm, global = true)
cameraHoleBottomRight = clone(cameraHoleTopRight)
  |> translate(x = -1.6mm, z = -12.5mm, global = true)
cameraBoardCut1 = subtract([cameraBoardBlank], tools = [cameraHoleTopLeft])
cameraBoardCut2 = subtract([cameraBoardCut1], tools = [cameraHoleTopRight])
cameraBoardCut3 = subtract([cameraBoardCut2], tools = [cameraHoleBottomLeft])
cameraBoard = subtract([cameraBoardCut3], tools = [cameraHoleBottomRight])
  |> appearance(color = pcbGreen, roughness = 58, metalness = 0)
cameraSensor = clone(unitBox)
  |> scale(
       x = 8.9,
       y = 2.4,
       z = 8.9,
       global = true,
     )
  |> translate(y = -1.8mm, z = 1mm, global = true)
  |> appearance(color = graphite, roughness = 38, metalness = 24)
cameraLensBarrel = clone(unitCylY)
  |> scale(
       x = 6.98,
       y = 7,
       z = 6.98,
       global = true,
     )
  |> translate(y = -5mm, z = 1mm, global = true)
  |> appearance(color = tacticalBlack, roughness = 28, metalness = 16)
cameraLens = clone(unitCylY)
  |> scale(
       x = 5.75,
       y = 0.9,
       z = 5.75,
       global = true,
     )
  |> translate(y = -8.4mm, z = 1mm, global = true)
  |> appearance(
       color = "#18364b",
       roughness = 8,
       metalness = 4,
       opacity = 90,
     )
acrylicShield = clone(unitCylY)
  |> scale(
       x = 14.5,
       y = 0.8,
       z = 14.5,
       global = true,
     )
  |> translate(y = -8.8mm, z = 1mm, global = true)
  |> appearance(
       color = "#b9d5df",
       roughness = 8,
       metalness = 0,
       opacity = 34,
     )
cameraRibbonSocket = clone(unitBox)
  |> scale(
       x = 16,
       y = 3.3,
       z = 4,
       global = true,
     )
  |> translate(y = 2.1mm, z = -8.8mm, global = true)
  |> appearance(color = graphite, roughness = 42, metalness = 16)

export cameraModule = flatten([
  cameraBoard,
  cameraSensor,
  cameraLensBarrel,
  cameraLens,
  acrylicShield,
  cameraRibbonSocket
])

hide(unitBox)
hide(unitCylY)
cameraModule
