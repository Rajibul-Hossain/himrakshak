// Power bank envelope
// 150 x 70 x 20 mm removable battery pack with cable-end details.
@settings(defaultLengthUnit = mm, kclVersion = 2.0, experimentalFeatures = allow)

import * from "parameters.kcl"
import unitBox from "unit_box.kcl"

powerBankBody = clone(unitBox)
  |> scale(
       x = powerBankWidth / 1mm,
       y = powerBankDepth / 1mm,
       z = powerBankHeight / 1mm,
       global = true,
     )
  |> appearance(color = graphite, roughness = 68, metalness = 8)
powerBankEndCapTop = clone(unitBox)
  |> scale(
       x = 66,
       y = 20.8,
       z = 5,
       global = true,
     )
  |> translate(z = 72.5mm, global = true)
  |> appearance(color = tacticalBlack, roughness = 72, metalness = 4)
powerBankEndCapBottom = clone(powerBankEndCapTop)
  |> translate(z = -145mm, global = true)
powerBankUsbPort = clone(unitBox)
  |> scale(
       x = 13,
       y = 2,
       z = 6,
       global = true,
     )
  |> translate(y = -11mm, z = -67mm, global = true)
  |> appearance(color = hardwareSteel, roughness = 30, metalness = 74)
powerBankCableRelief = clone(unitBox)
  |> scale(
       x = 18,
       y = 5,
       z = 8,
       global = true,
     )
  |> translate(y = -11.5mm, z = -58mm, global = true)
  |> appearance(color = rubberBlack, roughness = 92, metalness = 0)

export powerBank = flatten([
  powerBankBody,
  powerBankEndCapTop,
  powerBankEndCapBottom,
  powerBankUsbPort,
  powerBankCableRelief
])

hide(unitBox)
powerBank
